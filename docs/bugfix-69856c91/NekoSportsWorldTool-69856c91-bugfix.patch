+        for seed in 0..16 {
+            // Campus perimeter is 960 m; 5 km must reuse school roads.
+            let track = build_road(5000.0, 2000, seed, 123000, &points, &points, &net).unwrap();
+            assert!((track.totalDistance - 5000.0).abs() < 0.001);
